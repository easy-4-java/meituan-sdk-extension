<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sankuai.sjst</groupId>
    <artifactId>MtOpJavaSDK</artifactId>
    <version>1.0-20260630.083612-1</version>
    <packaging>jar</packaging>

    <name>MtOpJavaSDK</name>
    <description>美团技术服务合作中心 Java SDK（含外卖、团购、配送、到店、餐饮等业务强类型 Request/Response 模型与 MeituanClient 客户端）</description>
    <url>https://developer.meituan.com/sdk-download</url>

    <licenses>
        <license>
            <name>Proprietary</name>
            <url>https://developer.meituan.com</url>
        </license>
    </licenses>

    <organization>
        <name>美团（三快科技）</name>
        <url>https://www.meituan.com</url>
    </organization>

    <scm>
        <url>https://developer.meituan.com</url>
    </scm>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.8.9</version>
        </dependency>
        <dependency>
            <groupId>javax.validation</groupId>
            <artifactId>validation-api</artifactId>
            <version>2.0.1.Final</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>6.1.0.Final</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>javax.el</artifactId>
            <version>3.0.1-b11</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.25</version>
        </dependency>
    </dependencies>
</project>
